+					<p epub:type="z3998:signature">“Hannah Mullet.”</p>
+				</footer>
 			</blockquote>
 			<blockquote epub:type="z3998:letter">
 				<p epub:type="z3998:salutation">“Head Nurse of Ward <abbr>No.</abbr> 2⁠—</p>
